style.css:
body {
  background-color: #00e54;
  color: #00e5ff;
  font-family: monospace;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
}

.container {
  text-align: center;
  width: 90%;
  max-width: 400px;
}

.jarvis-title {
  font-size: 3rem;
  text-shadow: 0 0 10px #00e5ff, 0 0 20px #00e5ff;
  margin-bottom: 5px;
}

.status-panel {
  border: 1px solid #00e5ff;
  padding: 15px;
  margin: 20px 0;
  box-shadow: 0 0 15px rgba(0, 229, 255, 0.3);
  text-align: left;
}

.input-group {
  display: flex;
  gap: 10px;
}

input {
  flex-grow: 1;
  background: #0d1117;
  border: 1px solid #00e5ff;
  color: #00e5ff;
  padding: 10px;
  border-radius: 20px;
}

#sendBtn {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: #00e5ff;
  border: none;
  box-shadow: 0 0 15px #00e5ff;
  cursor: pointer;
  font-weight: bold;
}
